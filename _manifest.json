{
  "manifest_version": 2,
  "id": "maibot-community.mai-life-suite",
  "version": "1.2.1",
  "name": "MaiLifeSuite（麦麦生活套件）",
  "description": "Mai_life 与 MaiTrace 的合并插件：持续生活模拟、消息体验、联网见闻、书柜创作，以及每日作息、临时约定与 QQ 空间分享。",
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png"
    }
  },
  "author": {
    "name": "lightning",
    "url": "https://github.com/lightningXMS"
  },
  "license": "AGPL-3.0-only",
  "urls": {
    "repository": "https://github.com/lightningXMS/MaiLifeSuite-----/tree/master",
    "homepage": "https://github.com/lightningXMS/MaiLifeSuite-----/tree/master",
    "issues": "https://github.com/lightningXMS/MaiLifeSuite-----/issues"
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.19.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24.0"
    },
    {
      "type": "python_package",
      "name": "beautifulsoup4",
      "version_spec": ">=4.12.0"
    },
    {
      "type": "python_package",
      "name": "json5",
      "version_spec": ">=0.9.0"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2024.1"
    },
    {
      "type": "python_package",
      "name": "chinese-calendar",
      "version_spec": ">=1.11.0"
    },
    {
      "type": "python_package",
      "name": "lunar-python",
      "version_spec": ">=1.4.0"
    },
    {
      "type": "python_package",
      "name": "playwright",
      "version_spec": ">=1.49,<2"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "config.get",
    "config.get_plugin",
    "llm.generate",
    "llm.get_available_models",
    "message.get_by_id",
    "message.get_by_time_in_chat",
    "chat.get_all_streams",
    "chat.get_private_streams",
    "chat.get_group_streams",
    "chat.get_stream_by_user_id",
    "chat.get_stream_by_group_id",
    "chat.open_session",
    "emoji.get_by_description",
    "database.get",
    "api.call",
    "api.list",
    "knowledge.search",
    "render.html2png",
    "frequency.set_adjust",
    "maisaka.proactive.trigger",
    "component.list_loaded_plugins"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
